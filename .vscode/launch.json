    "version": "0.2.0",
    "configurations": [
        // Source - https://stackoverflow.com/a/63325135
        // Posted by Sasha Ladnov
        // Retrieved 2026-06-24, License - CC BY-SA 4.0
        {
            "type": "node",
            "request": "launch",
            "name": "Nest Debug",
            "runtimeExecutable": "npm",
            "runtimeArgs": [
                "run",
                "start:debug",
                "--",
                "--inspect-brk"
            ],
            "console": "integratedTerminal",
            "restart": true,
            "protocol": "auto",
            "port": 9229,
            "autoAttachChildProcesses": true
        },
    ]
}