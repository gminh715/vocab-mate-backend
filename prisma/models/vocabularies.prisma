model UserVocabulary {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  articleSentenceTermId String    @map("article_sentence_term_id") @db.Uuid
  savedWordDisplay      String    @map("saved_word_display") @db.Text
  savedLemma            String    @map("saved_lemma") @db.Text
  savedPartOfSpeech     String    @map("saved_part_of_speech") @db.Text
  savedIpa              String?   @map("saved_ipa") @db.Text
  savedCefrLevel        CefrLevel @map("saved_cefr_level")
  savedMeaningVi        String    @map("saved_meaning_vi") @db.Text
  definitionEn          String?   @map("definition_en") @db.Text
  savedExamples         Json      @default("[]") @map("saved_examples") @db.JsonB
  savedAt               DateTime  @default(now()) @map("saved_at") @db.Timestamptz(6)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  // FSRS card state fields
  fsrsState         FsrsCardState @default(NEW) @map("fsrs_state")
  fsrsStability     Float?        @map("fsrs_stability")
  fsrsDifficulty    Float?        @map("fsrs_difficulty")
  fsrsScheduledDays Int           @default(0) @map("fsrs_scheduled_days")
  fsrsLearningSteps Int           @default(0) @map("fsrs_learning_steps")
  reviewCount       Int           @default(0) @map("review_count")
  lapseCount        Int           @default(0) @map("lapse_count")
  lastReviewedAt    DateTime?     @map("last_reviewed_at") @db.Timestamptz(6)
  nextReviewAt      DateTime?     @map("next_review_at") @db.Timestamptz(6)

  user                User                       @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_user_vocabularies_user")
  articleSentenceTerm ArticleSentenceTerm        @relation(fields: [articleSentenceTermId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_user_vocabularies_article_sentence_term")
  collectionItems     VocabularyCollectionItem[]
  tutorSessionItems   TutorSessionItem[]

  @@unique([userId, articleSentenceTermId], map: "uq_user_vocabularies_user_sentence_term")
  @@index([articleSentenceTermId], map: "idx_user_vocabularies_sentence_term")
  @@index([userId, fsrsState, nextReviewAt], map: "idx_user_vocabularies_fsrs_candidate")
  @@map("user_vocabularies")
}
