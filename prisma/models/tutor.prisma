model TutorSession {
  id                    String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                String             @map("user_id") @db.Uuid
  studyDate             DateTime           @map("study_date") @db.Date
  status                TutorSessionStatus @default(ACTIVE)
  targetDurationMinutes Int                @map("target_duration_minutes")
  targetActivityCount   Int                @map("target_activity_count")
  newWordTarget         Int                @map("new_word_target")
  startedAt             DateTime           @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt           DateTime?          @map("completed_at") @db.Timestamptz(6)
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime           @default(now()) @map("updated_at") @db.Timestamptz(6)

  user  User               @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_tutor_sessions_user")
  items TutorSessionItem[]

  @@unique([userId, studyDate], map: "uq_tutor_sessions_user_study_date")
  @@index([userId, status, studyDate], map: "idx_tutor_sessions_user_status_date")
  @@map("tutor_sessions")
}

model TutorSessionItem {
  id               String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId        String                 @map("session_id") @db.Uuid
  userVocabularyId String?                @map("user_vocabulary_id") @db.Uuid
  position         Int
  status           TutorSessionItemStatus @default(PENDING)
  questionType     TutorQuestionType      @map("question_type")
  isNewWord        Boolean                @map("is_new_word")

  // Public prompt data sent to frontend (no correct answer)
  questionPayload Json @map("question_payload") @db.JsonB

  // Private server-side grading data — never serialised before ANSWERED
  gradingSpec Json @map("grading_spec") @db.JsonB

  // User response fields (filled after answer submission)
  userAnswer     Json?     @map("user_answer") @db.JsonB
  isCorrect      Boolean?  @map("is_correct")
  hintUsed       Boolean   @default(false) @map("hint_used")
  responseTimeMs Int?      @map("response_time_ms")
  fsrsRating     Int?      @map("fsrs_rating")
  feedbackVi     String?   @map("feedback_vi") @db.Text
  generatedAt    DateTime  @default(now()) @map("generated_at") @db.Timestamptz(6)
  answeredAt     DateTime? @map("answered_at") @db.Timestamptz(6)

  session        TutorSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_tutor_session_items_session")
  userVocabulary UserVocabulary? @relation(fields: [userVocabularyId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_tutor_session_items_vocabulary")

  @@unique([sessionId, position], map: "uq_tutor_session_items_session_position")
  @@index([sessionId, status], map: "idx_tutor_session_items_session_status")
  @@map("tutor_session_items")
}
