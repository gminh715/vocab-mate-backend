model User {
  id                String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email             String     @unique(map: "uq_users_email") @db.Citext
  passwordHash      String     @map("password_hash") @db.Text
  role              UserRole   @default(USER)
  status            UserStatus @default(ACTIVE)
  lastLoginAt       DateTime?  @map("last_login_at") @db.Timestamptz(6)
  displayName       String     @map("display_name") @db.Text
  avatarUrl         String?    @map("avatar_url") @db.Text
  currentCefrLevel  CefrLevel? @map("current_cefr_level")
  learningGoal      String?    @map("learning_goal") @db.Text
  preferredLanguage String     @default("vi") @map("preferred_language") @db.VarChar(20)
  dailyStudyMinutes Int        @default(10) @map("daily_study_minutes")
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime   @default(now()) @map("updated_at") @db.Timestamptz(6)

  categoriesCreated     Category[]             @relation("CategoryCreatedBy")
  categoriesUpdated     Category[]             @relation("CategoryUpdatedBy")
  articleProgress       UserArticleProgress[]
  vocabularies          UserVocabulary[]
  vocabularyCollections VocabularyCollection[]
  refreshSessions       RefreshSession[]
  tutorSessions         TutorSession[]

  @@map("users")
}

model RefreshSession {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String    @map("user_id") @db.Uuid
  tokenHash           String    @unique(map: "uq_refresh_sessions_token_hash") @map("token_hash") @db.Char(64)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt           DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt           DateTime? @map("revoked_at") @db.Timestamptz(6)
  replacedBySessionId String?   @unique(map: "uq_refresh_sessions_replaced_by") @map("replaced_by_session_id") @db.Uuid

  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_refresh_sessions_user")
  replacedBy RefreshSession? @relation("RefreshSessionRotation", fields: [replacedBySessionId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_refresh_sessions_replaced_by")
  replaces   RefreshSession? @relation("RefreshSessionRotation")

  @@index([userId, revokedAt], map: "idx_refresh_sessions_user_revoked")
  @@map("refresh_sessions")
}
