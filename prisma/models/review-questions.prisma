model ReviewQuestion {
  id                    String                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  articleSentenceTermId String                         @map("article_sentence_term_id") @db.Uuid
  questionType          QuestionType                   @map("question_type")
  generationSource      ReviewQuestionGenerationSource @default(AI) @map("generation_source")
  generationVersion     String?                        @map("generation_version") @db.VarChar(50)
  difficultyCefr        CefrLevel                      @map("difficulty_cefr")
  prompt                String                         @db.Text
  blankSentence         String?                        @map("blank_sentence") @db.Text
  correctAnswerText     String?                        @map("correct_answer_text") @db.Text
  answerExplanation     String?                        @map("answer_explanation") @db.Text
  isCaseSensitive       Boolean                        @default(false) @map("is_case_sensitive")
  points                Int                            @default(1)
  displayOrder          Int                            @default(1) @map("display_order")
  isActive              Boolean                        @default(true) @map("is_active")
  createdAt             DateTime                       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                       @default(now()) @map("updated_at") @db.Timestamptz(6)

  articleSentenceTerm ArticleSentenceTerm    @relation(fields: [articleSentenceTermId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_review_questions_article_sentence_term")
  options             ReviewQuestionOption[]
  reviewSessionItems  ReviewSessionItem[]
  reviewAnswers       ReviewAnswer[]

  @@unique([articleSentenceTermId, difficultyCefr, questionType, generationVersion], map: "uq_review_questions_ai_cache", where: raw("is_active = true AND generation_source = 'AI'"))
  @@index([articleSentenceTermId], map: "idx_review_questions_sentence_term")
  @@index([articleSentenceTermId, generationSource, difficultyCefr, questionType, generationVersion], map: "idx_review_questions_cached", where: raw("is_active = true"))
  @@map("review_questions")
}

model ReviewQuestionOption {
  id               String                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reviewQuestionId String                         @map("review_question_id") @db.Uuid
  optionText       String                         @map("option_text") @db.Text
  isCorrect        Boolean                        @default(false) @map("is_correct")
  generationSource ReviewQuestionGenerationSource @default(AI) @map("generation_source")
  explanation      String?                        @db.Text
  displayOrder     Int                            @default(1) @map("display_order")
  createdAt        DateTime                       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                       @default(now()) @map("updated_at") @db.Timestamptz(6)

  reviewQuestion ReviewQuestion @relation(fields: [reviewQuestionId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_review_question_options_question")
  reviewAnswers  ReviewAnswer[]

  @@unique([reviewQuestionId, displayOrder], map: "uq_review_question_options_display_order")
  @@index([reviewQuestionId, isCorrect], map: "idx_review_question_options_question_correct")
  @@map("review_question_options")
}
