model ReviewSession {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String              @map("user_id") @db.Uuid
  sessionType ReviewSessionType   @map("session_type")
  quizId      String?             @map("quiz_id") @db.Uuid
  articleId   String?             @map("article_id") @db.Uuid
  status      ReviewSessionStatus @default(IN_PROGRESS)
  startedAt   DateTime            @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt DateTime?           @map("completed_at") @db.Timestamptz(6)
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime            @default(now()) @map("updated_at") @db.Timestamptz(6)

  user    User           @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_review_sessions_user")
  quiz    Quiz?          @relation(fields: [quizId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_review_sessions_quiz")
  article Article?       @relation(fields: [articleId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_review_sessions_article")
  answers ReviewAnswer[]

  @@index([userId, startedAt(sort: Desc)], map: "idx_review_sessions_user_started")
  @@index([quizId], map: "idx_review_sessions_quiz", where: raw("quiz_id IS NOT NULL"))
  @@map("review_sessions")
}

model ReviewAnswer {
  id                  String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reviewSessionId     String         @map("review_session_id") @db.Uuid
  articleVocabularyId String         @map("article_vocabulary_id") @db.Uuid
  userVocabularyId    String?        @map("user_vocabulary_id") @db.Uuid
  itemType            ReviewItemType @map("item_type")
  quizQuestionId      String?        @map("quiz_question_id") @db.Uuid
  selectedOptionId    String?        @map("selected_option_id") @db.Uuid
  userAnswerText      String?        @map("user_answer_text") @db.Text
  isCorrect           Boolean?       @map("is_correct")
  responseTimeMs      Int?           @map("response_time_ms")
  attemptNumber       Int            @default(1) @map("attempt_number")
  answeredAt          DateTime       @default(now()) @map("answered_at") @db.Timestamptz(6)
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  reviewSession     ReviewSession       @relation(fields: [reviewSessionId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_review_answers_session")
  articleVocabulary ArticleSentenceTerm @relation(fields: [articleVocabularyId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_review_answers_article_vocabulary")
  userVocabulary    UserVocabulary?     @relation(fields: [userVocabularyId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_review_answers_user_vocabulary")
  quizQuestion      QuizQuestion?       @relation(fields: [quizQuestionId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_review_answers_quiz_question")
  selectedOption    QuestionOption?     @relation(fields: [selectedOptionId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_review_answers_selected_option")

  @@index([reviewSessionId, answeredAt], map: "idx_review_answers_session_answered")
  @@index([articleVocabularyId, answeredAt(sort: Desc)], map: "idx_review_answers_vocabulary_answered")
  @@index([userVocabularyId, answeredAt(sort: Desc)], map: "idx_review_answers_user_vocabulary", where: raw("user_vocabulary_id IS NOT NULL"))
  @@index([reviewSessionId, isCorrect], map: "idx_review_answers_quiz_dashboard", where: raw("item_type = 'QUIZ_QUESTION'"))
  @@map("review_answers")
}
