# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL=" "

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL=" "

# Authentication secrets must be at least 32 characters.
JWT_ACCESS_SECRET="replace-with-a-long-random-access-secret"
JWT_ACCESS_EXPIRES_IN=900
JWT_REFRESH_SECRET="replace-with-a-different-long-random-refresh-secret"
JWT_REFRESH_EXPIRES_IN=604800
BCRYPT_ROUNDS=12
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# IANA timezone used for analytics date buckets. Users do not have timezones.
ANALYTICS_TIMEZONE=UTC

# Server-side contextual-term enrichment and review AI.
GEMINI_API_KEY="replace-with-a-gemini-api-key"
GEMINI_MODEL="gemini-3.5-flash-lite"
GROQ_API_KEY="replace-with-a-groq-api-key"
# Prefer a model with Groq Strict Structured Outputs for reliable fallback.
GROQ_MODEL="openai/gpt-oss-20b"
AI_REQUEST_TIMEOUT_MS=30000
AI_REVIEW_AGENT_ENABLED=false
AI_REVIEW_MAX_CALLS_PER_SESSION=10
AI_REVIEW_MAX_DIAGNOSIS_CALLS=4
AI_REVIEW_MIN_CONFIDENCE=0.65
AI_REVIEW_PROMPT_VERSION=review-agent-v1
# Maximum synchronous warm-up batches per session; each batch holds up to four questions.
AI_REVIEW_QUESTION_WARM_LIMIT=5

# Guardian Content API discovery and draft import. Never expose this key to
# browser code, logs, or complete request URLs.
GUARDIAN_API_KEY="replace-with-a-guardian-api-key"
# Developer access permits up to one call per second and 500 calls per day.
# The official API URL and all safety limits are fixed inside the backend.
# The process-local one-second throttle does not coordinate multiple instances.
# Register the key for this application and verify that the selected Guardian
# access tier/content licence permits the intended ingestion and AI-processing
# use before enabling the flow.
